<mxfile host="app.diagrams.net" type="device" version="24.7.17"><diagram id="underground-left-edge" name="Winding paths - dry undersea exit"><mxGraphModel dx="2220" dy="1390" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2220" pageHeight="1390" math="0" shadow="0" background="#101A22"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="SILENT CITY / UNDERGROUND PATH" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#EDF3F4;fontSize=30;fontFamily=Arial;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="42" width="1460" height="44" /></mxCell><mxCell id="subtitle" value="Start at the LEFT EDGE of your current cave. Winding paths turn left, down, and right toward a DRY exit below the seabed." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#A8BAC2;fontSize=19;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="94" width="2080" height="28" /></mxCell><mxCell id="legend" value="TEAL = suggested route     GRAY = two-way exploration     RUST = optional boss branch     GOLD DASH = unlock shortcut     GREEN SAVE = save place" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#A8BAC2;fontSize=15;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="141" width="2080" height="30" /></mxCell><mxCell id="sea-context" value="SEA - EXISTING SCENE CONTEXT&#10;Sea shown in the first and second scenes" style="rounded=0;html=0;whiteSpace=wrap;fillColor=#143C50;strokeColor=#407B96;fontColor=#EDF3F4;fontSize=19;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="1640" y="205" width="510" height="205" /></mxCell><mxCell id="seabed-context" value="SOLID SEABED / ROCK&#10;Solid ground keeps the passage dry" style="rounded=0;html=0;whiteSpace=wrap;fillColor=#353B44;strokeColor=#77808B;fontColor=#EDF3F4;fontSize=19;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="1640" y="410" width="510" height="180" /></mxCell><mxCell id="dry-tunnel-context" value="BENEATH THE SEA&#10;Exit is underground, not inside the water" style="rounded=0;html=0;whiteSpace=wrap;fillColor=#17252A;strokeColor=#61767B;fontColor=#EDF3F4;fontSize=19;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="1640" y="590" width="510" height="575" /></mxCell><mxCell id="sea-note" value="Water and seabed are context only.&#10;The route never enters the sea." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#A8BAC2;fontSize=16;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry as="geometry" x="1660" y="1195" width="500" height="62" /></mxCell><mxCell id="route0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#71D6DA;strokeWidth=3;endArrow=block;endFill=1;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="room01" target="room02"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1290" y="300" /><mxPoint x="1290" y="315" /></Array></mxGeometry></mxCell><mxCell id="route1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#71D6DA;strokeWidth=3;endArrow=block;endFill=1;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="room02" target="room03"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="995" y="315" /><mxPoint x="995" y="380" /><mxPoint x="855" y="380" /></Array></mxGeometry></mxCell><mxCell id="route2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#71D6DA;strokeWidth=3;endArrow=block;endFill=1;exitX=0.0;exitY=