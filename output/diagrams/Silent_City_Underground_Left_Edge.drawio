eometry" x="1330" y="391" width="300" height="55" /></mxCell><mxCell id="edge-marker" value="" style="line;strokeColor=#71D6DA;strokeWidth=3;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="1330" y="215" width="0" height="170" /></mxCell><mxCell id="shortcut-note" value="Arena shortcut&#10;12 to 08 opens after victory.&#10;Two-way after unlocking." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#EAC16D;fontSize=14;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry as="geometry" x="1170" y="1020" width="370" height="72" /></mxCell><mxCell id="optional-rewards" value="OPTIONAL BOSS REWARDS&#10;Completion-bar credit + money for powers.&#10;The main route stays open if you skip the boss." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#EEA38D;fontSize=16;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="1280" width="840" height="90" /></mxCell><mxCell id="route-note" value="PATH SHAPE: leave left &gt; descend and loop &gt; turn right &gt; dry tunnel beneath the sea" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#71D6DA;fontSize=17;fontFamily=Arial;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="460" y="1171" width="1130" height="30" /></mxCell><mxCell id="save-places" value="SAVE PLACES: 02 Moss Crossroads / 06 Flooded Archive / 11 Old Crypt&#10;Proposed safe spots for saving progress.&#10;Keep enemies outside the save area; the boss remains optional." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#9BE0B0;fontSize=16;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry as="geometry" x="950" y="1280" width="1200" height="75" /></mxCell><mxCell id="footer" value="Proposal only: room connections wind through the underground. Sea placement is schematic; the exit remains separated from water by solid rock." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#A8BAC2;fontSize=14;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="1358" width="2100" height="25" /></mxCell></root></mxGraphModel></diagram></mxfile>