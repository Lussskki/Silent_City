=middle;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1330" y="230" width="260" height="140" /></mxCell><mxCell id="room02" value="02  Moss Crossroads&#10;Choose a winding route" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#15383E;strokeColor=#71D6DA;fontColor=#EDF3F4;fontFamily=Arial;fontSize=16;fontStyle=1;spacing=12;align=left;verticalAlign=middle;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1030" y="270" width="210" height="90" /></mxCell><mxCell id="save02" value="SAVE" style="rounded=1;html=0;fillColor=#9BE0B0;strokeColor=#65B97E;fontColor=#123222;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="room02"><mxGeometry as="geometry" x="144" y="65" width="55" height="18" /></mxCell><mxCell id="room03" value="03  Reed Pools&#10;Decorative cave water" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#15383E;strokeColor=#71D6DA;fontColor=#EDF3F4;fontFamily=Arial;fontSize=16;fontStyle=1;spacing=12;align=left;verticalAlign=middle;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="750" y="410" width="210" height="90" /></mxCell><mxCell id="room04" value="04  Root Gallery&#10;Turn back left / descend" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#15383E;strokeColor=#71D6DA;fontColor=#EDF3F4;fontFamily=Arial;fontSize=16;fontStyle=1;spacing=12;align=left;verticalAlign=middle;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="470" y="300" width="210" height="90" /></mxCell><mxCell id="room05" value="05  Broken Aqueduct&#10;Deep descent / long bend" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#15383E;strokeColor=#71D6DA;fontColor=#EDF3F4;fontFamily=Arial;fontSize=16;fontStyle=1;spacing=12;align=left;verticalAlign=middle;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="180" y="540" width="210" height="90" /></mxCell><mxCell id="room07" value="07  Lower Passage&#10;Loop toward crossroads" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#1C2A3