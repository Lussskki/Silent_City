[node name="DesignNotes" type="Node" parent="." unique_id=1192771839]
metadata/route = "awakening > teaching > pressure > crypt memory > short bridge > final graves > exit"
metadata/collision_rule = "terrain and bridge collide; decorations do not"
metadata/readability_rule = "lanterns mark landmarks and both bridge landings"
metadata/enemy_policy = "grave tells, emergence, Easy chase/attack/recovery, death, and HUD counting"
metadata/background_policy = "one moon; layered hills, fog, grounded houses; no cemetery waterfall"
metadata/waterfall_policy = "one world-space assembly below and behind the bridge"
metadata/ground_policy = "surface remains at y=620; visual soil extends below the camera with two-row overscan"
metadata/online_scope = "story-only scene; online scenes and resources are unchanged"

