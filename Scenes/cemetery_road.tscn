[sub_resource type="Shader" id="BrokenWallWaterShader"]
code = "shader_type canvas_item;
varying vec4 water_tint;
void vertex() { water_tint = COLOR; }
void fragment() {
 vec4 source = texture(TEXTURE, UV);
 float value = max(source.r, max(source.g, source.b));
 float edge = smoothstep(0.0, 0.055, UV.x) * smoothstep(0.0, 0.055, 1.0 - UV.x);
 edge *= smoothstep(0.0, 0.045, UV.y) * smoothstep(0.0, 0.055, 1.0 - UV.y);
 source.a *= smoothstep(0.20, 0.39, value) * edge;
 COLOR = source * water_tint;
}"

