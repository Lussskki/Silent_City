[sub_resource type="Shader" id="DecorativeCaveWaterShader"]
code = "shader_type canvas_item;
render_mode unshaded;
uniform bool soft_edges = false;
void fragment() {
 vec2 p = floor(UV * vec2(2300.0, 150.0) / 3.0) * 3.0;
 float shore = 7.0 + sin(p.x * 0.016) * 3.0 + sin(p.x * 0.045 + TIME * 0.55) * 1.5;
 float depth = p.y - shore;
 vec3 water = mix(vec3(0.045, 0.075, 0.14), vec3(0.018, 0.032, 0.075), smoothstep(0.0, 140.0, depth));
 float ripple = step(0.93, sin(p.x * 0.035 + TIME * 0.45 + floor(p.y / 12.0) * 2.4));
 ripple *= step(0.72, cos(p.y * 0.52)) * (1.0 - smoothstep(25.0, 130.0, depth));
 water += ripple * vec3(0.025, 0.04, 0.065);
 water = mix(water, vec3(0.13, 0.21, 0.31), (1.0 - smoothstep(0.0, 3.0, depth)) * 0.5);
 COLOR = vec4(water, smoothstep(0.0, 4.0, depth) * 0.4 * (1.0 - smoothstep(0.65, 1.0, UV.y)));
 if (soft_edges) {
  COLOR.a *= smoothstep(0.0, 0.04, UV.x) * (1.0 - smoothstep(0.96, 1.0, UV.x));
 }
}"

