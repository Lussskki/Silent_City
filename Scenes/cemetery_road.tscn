[sub_resource type="Shader" id="WalkableTunnelRockShader"]
code = "shader_type canvas_item;
uniform sampler2D rock_texture : source_color, filter_linear, repeat_enable;
uniform bool ceiling = false;
varying vec2 world_position;
void vertex() { world_position = (MODEL_MATRIX * vec4(VERTEX, 0.0, 1.0)).xy; }
void fragment() {
 float floor_level = 620.0 + clamp((-world_position.x - 1920.0) / 1120.0, 0.0, 1.0) * 256.0;
 float surface = ceiling ? floor_level - 440.0 : floor_level;
 float depth = ceiling ? surface - world_position.y : world_position.y - surface;
 float u = fract((world_position.x + (ceiling ? 384.0 : 0.0)) / 2048.0);
 float v = clamp(0.022 + depth / 620.0, 0.022, 0.94);
 vec3 rock = texture(rock_texture, vec2(u, v)).rgb;
 rock *= ceiling ? vec3(0.58, 0.64, 0.82) : vec3(0.86, 0.91, 1.0);
 rock = mix(rock, vec3(0.008, 0.012, 0.025), smoothstep(300.0, 700.0, depth));
 COLOR = vec4(rock, 1.0);
}"

[sub_resource type="ShaderMaterial" id="TunnelFloorMaterial"]
shader = SubResource("WalkableTunnelRockShader")
shader_parameter/rock_texture = ExtResource("redraw_ground")
shader_parameter/ceiling = false

[sub_resource type="ShaderMaterial" id="TunnelRoofMaterial"]
shader = SubResource("WalkableTunnelRockShader")
shader_parameter/rock_texture = ExtResource("redraw_ground")
shader_parameter/ceiling = true

[sub_resource type="Shader" id="TunnelBackgroundRockShader"]
code = "shader_type canvas_item;
uniform sampler2D rock_texture : source_color, filter_linear, repeat_enable;
varying vec2 wall_position;
void vertex() { wall_position = VERTEX; }
void fragment() {
 vec2 p = wall_position;
 float u = fract((p.x + 4608.0) / 1800.0 + sin(p.y / 370.0) * 0.07);
 float phase = (p.y + 450.0) / 900.0 + sin(p.x / 320.0) * 0.045;
 float stone_y = 1.0 - abs(fract(phase) * 2.0 - 1.0);
 float v = 0.07 + stone_y * 0.38;
 vec3 rock = texture(rock_texture, vec2(u, v)).rgb;
 rock = rock * vec3(0.68, 0.74, 0.84) + vec3(0.006, 0.009, 0.016);
 COLOR = vec4(rock, 1.0);
}"

[sub_resource type="ShaderMaterial" id="TunnelBackgroundRockMaterial"]
