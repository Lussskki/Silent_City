[sub_resource type="Shader" id="RoadSeaCliffShader"]
code = "shader_type canvas_item;
uniform sampler2D rock_texture : source_color, filter_linear, repeat_disable;
varying vec2 world_position;
void vertex() { world_position = (MODEL_MATRIX * vec4(VERTEX, 0.0, 1.0)).xy; }
void fragment() {
 vec2 patch_size = vec2(450.0, 270.0);
 vec2 p = (world_position - vec2(1880.0, -512.0)) / patch_size;
 vec2 mirrored = vec2(1.0) - abs(mod(p, vec2(2.0)) - vec2(1.0));
 vec2 rock_uv = (vec2(80.0, 50.0) + mirrored * patch_size) / vec2(textureSize(rock_texture, 0));
 vec3 rock = texture(rock_texture, rock_uv).rgb;
 COLOR = vec4(rock * vec3(0.72, 0.8, 0.9), texture(TEXTURE, UV).a);
}"

[sub_resource type="ShaderMaterial" id="RoadSeaCliffMaterial"]
