[sub_resource type="Shader" id="CaveBackdropShader"]
code = "shader_type canvas_item;
render_mode unshaded;
void fragment() {
 vec2 p = UV;
 vec3 color = mix(vec3(0.052, 0.059, 0.092), vec3(0.15, 0.15, 0.21), smoothstep(0.0, 1.0, p.y));
 float haze = exp(-pow((p.x - 0.5) * 3.5, 2.0) - pow((p.y - 0.55) * 2.5, 2.0));
 COLOR = vec4(color + vec3(0.025, 0.055, 0.06) * haze, 1.0);
}"

